{
    "name": "kinne",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
        "catalog:sync": "tsx --env-file=.env.local scripts/sync-catalog.ts"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.2.0",
        "drizzle-orm": "^0.45.4",
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^24.19.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": "24.x"
    }
}
