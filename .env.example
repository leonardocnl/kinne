TMDB_TOKEN=
DATABASE_URL=
DATABASE_URL_POOLED=
# Conexão do papel kinne_app (site) no branch develop, para testar o site com as permissões reais
KINNE_APP_DATABASE_URL_POOLED=
TEAM_SECRET_PATH=
# Carga do catálogo: conexão direta do papel kinne_sync, alvo develop|production (C3)
SYNC_DATABASE_URL=
SYNC_TARGET=
# Invalidação do cache ao fim da carga (C4); o segredo também vai nas variáveis da Vercel
REVALIDATE_ORIGIN=
REVALIDATE_SECRET=
# Busca de títulos (docs/threats/title-search.md). Interruptor do TMDB: on|off (I2); sem ele, off.
SEARCH_TMDB_FALLBACK=
# Segredo do sal diário do limitador (32+ caracteres aleatórios); sem ele, a busca no TMDB fica desligada (E3)
RATE_LIMIT_SECRET=
# Limites opcionais (H1); vazios usam os padrões: 600, 60, 30, 2000
SEARCH_CATALOG_PER_MINUTE=
SEARCH_FALLBACK_PER_MINUTE=
SEARCH_TMDB_PER_MINUTE=
SEARCH_TMDB_PER_DAY=
