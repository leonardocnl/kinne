{
    "id": 25820492,
    "name": "protect-develop",
    "target": "branch",
    "source_type": "Repository",
    "source": "leonardocnl/kinne",
    "enforcement": "active",
    "conditions": { "ref_name": { "exclude": [], "include": ["refs/heads/develop"] } },
    "rules": [
